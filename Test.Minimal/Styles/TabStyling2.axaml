<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
            <Border Padding="20" Background="#1E1F22">
                <TabControl>
                    <TabItem Header="Dashboard" />
                    <TabItem Header="Analytics" />
                    <TabItem Header="Settings" />
                </TabControl>
            </Border>
        </Border>
    </Design.PreviewWith>

    <!-- Add Styles Here -->
    
    <!-- TabControl: Rider/Discord inspired dark greyscale -->
    <Style Selector="TabControl">
        <Setter Property="Background" Value="#1E1F22" />
        <Setter Property="Foreground" Value="#B9BBBE" />
        <Setter Property="BorderBrush" Value="#2B2D31" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- TabItem: flat grey tabs -->
    <Style Selector="TabItem">
        <Setter Property="Background" Value="#2B2D31" />
        <Setter Property="Foreground" Value="#949BA4" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Margin" Value="0" />

        <!-- Custom template for cleaner look -->
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="4,4,0,0"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter
                        Content="{TemplateBinding Header}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Hover -->
    <Style Selector="TabItem:pointerover">
        <Setter Property="Background" Value="#35373C" />
        <Setter Property="Foreground" Value="#DBDEE1" />
    </Style>

    <!-- Selected: matches editor background -->
    <Style Selector="TabItem:selected">
        <Setter Property="Background" Value="#1E1F22" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Disabled -->
    <Style Selector="TabItem:disabled">
        <Setter Property="Background" Value="#25272C" />
        <Setter Property="Foreground" Value="#6D6F78" />
    </Style>

    <!-- Pinned tabs: slightly lighter grey to stand out subtly -->
    <Style Selector="TabItem:pinned">
        <Setter Property="Background" Value="#383A40" />
        <Setter Property="Foreground" Value="#B9BBBE" />
    </Style>
    <Style Selector="TabItem:pinned:pointerover">
        <Setter Property="Background" Value="#41434A" />
        <Setter Property="Foreground" Value="#DBDEE1" />
    </Style>
    <Style Selector="TabItem:pinned:selected">
        <Setter Property="Background" Value="#1E1F22" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    
</Styles>
